DATABASE_URL=postgresql+asyncpg://user:password@localhost/restos
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
ANTHROPIC_API_KEY=your-anthropic-key

# Telegram bot (get token from @BotFather)
BOT_TOKEN_VENUE_1=your-bot-token

# Get these UUIDs from your database:
# SELECT id FROM networks LIMIT 1;
# SELECT id FROM venues WHERE name = 'your-venue-name';
NETWORK_ID=uuid-of-your-network
VENUE_ID_1=uuid-of-venue-for-bot

# Internal shared secret between bot and API (generate with: openssl rand -hex 32)
BOT_API_SECRET=change-this-to-a-random-secret

# Public URL of this deployment (used for Stripe redirect/webhook URLs).
# Must be https:// in production — auth cookies only get marked Secure and
# HSTS only activates when this starts with https:// (see app/main.py and
# app/routers/auth.py). See nginx/nginx.conf for the one-time certbot setup.
PUBLIC_URL=https://your-domain.com

# Stripe billing (leave empty to disable online payment — /billing shows a "contact support" fallback)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=

# Your email — grants access to /platform/admin (all-tenant overview). Leave empty to disable.
PLATFORM_ADMIN_EMAIL=

# Sentry error monitoring — free tier (5k errors/mo) is enough to start.
#   1. sentry.io → sign up → Create Project → platform: Python → framework: FastAPI
#   2. Settings → Client Keys (DSN) → copy the DSN, paste below
# Leave empty to disable (errors still get logged to stdout either way).
SENTRY_DSN=

# Transactional email (password reset, staff invites). Leave SMTP_HOST empty in dev —
# emails are logged instead of sent, nothing breaks, you just won't receive them.
#
# Quickest to set up for a KZ-based business — pick one:
#
#   Yandex 360 (free, mail@your-domain.com via Yandex, good deliverability in CIS):
#     1. connect.yandex.ru → add your domain → verify via DNS TXT record
#     2. create a mailbox, e.g. no-reply@your-domain.com
#     3. id.yandex.ru/security/app-passwords → generate an app password (not your login password)
#     SMTP_HOST=smtp.yandex.ru   SMTP_PORT=465 (or 587)   SMTP_USER=no-reply@your-domain.com
#
#   AWS SES (cheapest at volume, needs sandbox-exit request for real customers):
#     1. AWS Console → SES → verify your domain (DNS records) → request production access
#     2. SES → SMTP settings → create SMTP credentials
#     SMTP_HOST=email-smtp.<region>.amazonaws.com   SMTP_PORT=587
#
#   Mailgun (simplest signup, good docs):
#     1. mailgun.com → add domain → verify via DNS → Sending → SMTP credentials
#     SMTP_HOST=smtp.mailgun.org   SMTP_PORT=587
#
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=RestOS <no-reply@your-domain.com>

# Set to false to disable rate limiting on auth endpoints (not recommended in production)
RATE_LIMIT_ENABLED=true

# Set to false to disable the Origin/Referer CSRF check on cookie-authenticated
# writes (not recommended in production — make sure PUBLIC_URL above is correct instead)
CSRF_ENABLED=true
