msgstr "RestOS — Новий пароль"

msgid "RestOS — Платформа управления рестораном"
msgstr "RestOS — Платформа керування рестораном"

msgid "RestOS — Регистрация"
msgstr "RestOS — Реєстрація"

msgid ""
"RestOS — приём заказов, кухонный дисплей, склад, смены персонала, "
"программа лояльности и фискализация чеков в одной панели. 14 дней "
"бесплатно."
msgstr ""
"RestOS — приймання замовлень, кухонний дисплей, склад, зміни персоналу, "
"програма лояльності та фіскалізація чеків в одній панелі. 14 днів "
"безкоштовно."

